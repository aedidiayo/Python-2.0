import random
word_list=['python','mathematics','english','government','literature']
def jumble_word(word):
    word_list=list(word)
    random.shuffle(word_list)
    return ''.join(word_list)

def get_hint(word):
    return f"The first letter of the word is:{word[0].upper()}"

def play_game():
    score=0
    rounds=3
    print("welcome to the advance word jumble game")
    for round_number in range(1,rounds+1):
        word=random.choice(word_list)
        scrambled_word=jumble_word(word)
        print("your task is to guess the originl word from the scrambled version")
        print(f"round:{round_number}")
        print(f"Here is the scrambled word:{scrambled_word}")
        hint_choice=input("do you want a hint? (yes/no):").lower()
        if hint_choice == 'yes':
            print(get_hint(word))

        #ALLOW THE USER TO GET THE ORIGINAL WORD
        guess=input("guess the original word:").lower()
        while not guess.isalpha():
            print("please enterr a vaid word!")
            guess=input("guess the original word:")
        if guess == word:
            print("congratulations! you guessed right")
            score+=1
        else:
            print("Apologies your guess isn't right\n the correct word is:{word}")
    print(f"\n game over!\n your final score is {score}/{rounds}.")

play_game()
